# ============================================================
# TechContent AI — Variables de Entorno
# Copiar este archivo a la raiz del repo como .env y completar los valores reales.
# NUNCA commitear el .env con valores reales.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=techcontent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here

# --- Spring Boot ---
SPRING_PORT=8080

# --- Supabase ---
SUPABASE_AUTH_URL=http://localhost:9999
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# --- GoTrue (entorno local) ---
GOTRUE_SITE_URL=http://localhost:3001
GOTRUE_MAILER_AUTOCONFIRM=true

# --- ML Service ---
ML_SERVICE_PORT=5000
MODEL_PATH=./models/classifier.joblib

# --- OCI Object Storage ---
OCI_CLI_USER=ocid1.user.oc1..your_user_ocid
OCI_CLI_TENANCY=ocid1.tenancy.oc1..your_tenancy_ocid
OCI_CLI_REGION=sa-saopaulo-1
OCI_CLI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_CLI_KEY_FILE=/root/.oci/private_key.pem
OCI_MODEL_BUCKET=techcontent-models
OCI_DATASET_BUCKET=techcontent-datasets
OCI_FILES_BUCKET=techcontent-files

# --- Frontend ---
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- CORS (en produccion setear al dominio real del frontend) ---
# Ejemplo: CORS_ALLOWED_ORIGINS=https://app.techcontent.ai
CORS_ALLOWED_ORIGINS=http://localhost:3001
