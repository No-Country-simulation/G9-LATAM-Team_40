# ── OCI Configuration ─────────────────────────────────────────────
OCI_CLI_USER=ocid1.user.oc1..xxxxx
OCI_CLI_TENANCY=ocid1.tenancy.oc1..xxxxx
OCI_CLI_REGION=sa-saopaulo-1
OCI_CLI_FINGERPRINT=xx:xx:xx:xx
OCI_CLI_KEY_FILE=~/.oci/oci_api_key.pem
OCI_MODEL_BUCKET=techcontent-models
OCI_DATASET_BUCKET=techcontent-datasets
OCI_FILES_BUCKET=techcontent-files

# ── Backend (Spring Boot) ────────────────────────────────────────
SPRING_PORT=8080
# NOTA: dentro de Docker Compose el backend usa http://ml-service:5000 (definido en docker-compose.yml)
ML_SERVICE_URL=http://localhost:5000

# ── ML Service (Python) ──────────────────────────────────────────
ML_SERVICE_PORT=5000
MODEL_PATH=./models/classifier.joblib

# ── PostgreSQL (Supabase DB) ─────────────────────────────────────
POSTGRES_DB=techcontent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
# Debe tener mínimo 32 caracteres
SUPABASE_JWT_SECRET=your-jwt-secret-min-32-chars-long!!
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/techcontent

# ── Supabase Auth (GoTrue) ──────────────────────────────────────
GOTRUE_URL=http://localhost:9999
GOTRUE_SITE_URL=http://localhost:8080
GOTRUE_MAILER_AUTOCONFIRM=true

# ── Frontend (Next.js) ──────────────────────────────────────────
# Puerto host del frontend (el 3000 del host lo ocupa PostgREST)
FRONTEND_PORT=3001
# Build-time (NEXT_PUBLIC_* va al bundle del navegador): URL host del backend
NEXT_PUBLIC_API_URL=http://localhost:8080
