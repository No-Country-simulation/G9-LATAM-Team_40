# ── OCI Configuration ─────────────────────────────────────────────
OCI_CLI_USER=ocid1.user.oc1..your_user_ocid
OCI_CLI_TENANCY=ocid1.tenancy.oc1..your_tenancy_ocid
OCI_CLI_REGION=your-oci-region
OCI_CLI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_CLI_KEY_FILE=/home/your-user/.oci/oci_api_key.pem
OCI_MODEL_BUCKET=techcontent-models
# Único bucket GraphRAG usado por el servicio ML.
OCI_DATASET_BUCKET=your-graphrag-dataset-bucket
OCI_FILES_BUCKET=techcontent-files
OCI_NAMESPACE=your-oci-namespace

# ── Backend (Spring Boot) ────────────────────────────────────────
SPRING_PORT=8080
# NOTA: dentro de Docker Compose el backend usa http://ml-service:5000 (definido en docker-compose.yml)
ML_SERVICE_URL=http://localhost:5000

# ── ML Service / GraphRAG (Python) ────────────────────────────────
ML_SERVICE_PORT=5000
DATA_SOURCE=oci
# Requerida por el pipeline para generar respuestas.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL_1=gemini-3.5-flash-lite
GEMINI_MODEL_2=gemini-3.1-flash-lite
MODELO_EMBEDDINGS=paraphrase-multilingual-mpnet-base-v2
SPACY_MODEL=es_dep_news_trf
BATCH_SIZE_EMBEDDINGS=32
DOCUMENTOS_POR_LOTE=5
MAX_CATEGORIAS_POR_DOCUMENTO=10
UMBRAL_CONFIANZA=0.60
CONCEPTOS_TOP_POR_SECCION=5
CONFIANZA_MINIMA_RELACION=0.75
SCORE_MINIMO_CONCEPTO=0.65
TOP_K_NODOS=5
TOP_K_SECCIONES_FINAL=5
OCI_PREFIX=prod
OCI_AUTH_MODE=api_key
OCI_SYNC_ON_STARTUP=true

# ── PostgreSQL (Supabase DB) ─────────────────────────────────────
POSTGRES_DB=techcontent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Supabase ─────────────────────────────────────────────────────
SUPABASE_URL=http://localhost:8000
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-key
# Debe tener mínimo 32 caracteres.
SUPABASE_JWT_SECRET=your-jwt-secret-min-32-chars-long!!
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:5432/techcontent

# ── Supabase Auth (GoTrue) ───────────────────────────────────────
GOTRUE_URL=http://localhost:9999
GOTRUE_SITE_URL=http://localhost:8080
GOTRUE_MAILER_AUTOCONFIRM=true

# ── Frontend (Next.js) ──────────────────────────────────────────
# Puerto host del frontend (el 3000 del host lo ocupa PostgREST)
FRONTEND_PORT=3001
# Build-time (NEXT_PUBLIC_* va al bundle del navegador): URL host del backend
NEXT_PUBLIC_API_URL=http://localhost:8080
